# Copy this file to .env.test before starting the test deployment.
# Keep passwords URL-safe because they are embedded in connection URLs.
NEW_API_TEST_PORT=3000
POSTGRES_USER=root
POSTGRES_PASSWORD=replace_this_postgres_password
POSTGRES_DB=new-api
REDIS_PASSWORD=replace_this_redis_password
SESSION_SECRET=replace_with_at_least_32_random_characters

# Use false only for an isolated HTTP test environment.
# For HTTPS, set this to true and set SESSION_COOKIE_TRUSTED_URL.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
